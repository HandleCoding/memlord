# ── Database ──────────────────────────────────────────────────────────────────
MEMLORD_DB_URL=postgresql+asyncpg://postgres:postgres@postgres/memlord

# ── ONNX model ────────────────────────────────────────────────────────────────
# Directory containing model.onnx and tokenizer.json.
MEMLORD_MODEL_DIR=/app/src/memlord/onnx

# ── Server ────────────────────────────────────────────────────────────────────
MEMLORD_HOST=0.0.0.0
MEMLORD_PORT=8000

# ── Search tuning ─────────────────────────────────────────────────────────────
# Reciprocal Rank Fusion constant. Lower k → steeper gaps between ranks.
# Default 20 works for personal/small and mid-size corpora; try 40–60 for
# very large libraries where many near-ties are expected.
# MEMLORD_RRF_K=20
# MEMLORD_DEFAULT_LIMIT=10
# MEMLORD_SIM_THRESHOLD=0.25
# MEMLORD_DEDUP_THRESHOLD=0.85
#
# Hybrid fusion weights (vector leg always weighted; FTS weight depends on
# whether remote embeddings are driving the vector search).
# MEMLORD_FUSION_W_VEC=1.0
# MEMLORD_FUSION_W_FTS_LOCAL=1.0
# MEMLORD_FUSION_W_FTS_REMOTE=0.5
# Drop FTS score when ts_rank < ratio * max(ts_rank) in the candidate set.
# MEMLORD_FTS_WEAK_RATIO=0.3
# Title boosts after RRF. Keep PARTIAL well below a single-path rank-1 score
# (≈1/(RRF_K+1); with k=20 that is ~0.048).
# MEMLORD_EXACT_NAME_BOOST=1.0
# MEMLORD_PARTIAL_NAME_BOOST=0.025
# Include per-component scores (score_fts / score_vec / score_name) in results:
# MEMLORD_SEARCH_DEBUG=false

# ── OAuth 2.1 ─────────────────────────────────────────────────────────────────
# MEMLORD_BASE_URL=http://localhost:8000
# MEMLORD_OAUTH_JWT_SECRET=change-me-to-a-long-random-secret

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# MEMLORD_SMTP_HOST=smtp.resend.com
# MEMLORD_SMTP_PORT=587
# MEMLORD_SMTP_USER=resend
# MEMLORD_SMTP_PASSWORD=re_xxxxxxxxxxxx
# MEMLORD_SMTP_FROM=noreply@example.com
# MEMLORD_SMTP_TLS=true

# ── Optional remote embeddings (OpenAI-compatible) ────────────────────────────
# Default: local ONNX only (384-d). Local vectors are ALWAYS written.
# When configured, store/search prefer the remote model and fall back to local
# if the API call fails/times out.
# MEMLORD_EMBEDDING_PROVIDER=openai_compatible
# MEMLORD_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# MEMLORD_EMBEDDING_API_KEY=sk-...
# MEMLORD_EMBEDDING_MODEL=BAAI/bge-m3
# MEMLORD_EMBEDDING_DIM=1024
# MEMLORD_EMBEDDING_TIMEOUT=10
# MEMLORD_EMBEDDING_RETRIES=2
# Use remote column for vector search when this fraction of candidates have it:
# MEMLORD_EMBEDDING_REMOTE_MIN_COVERAGE=0.5
